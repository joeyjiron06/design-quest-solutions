---
import "../global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Revit Drafting Consultants</title>
    <script>
      const darkModeMediaQuery = window.matchMedia(
        "(prefers-color-scheme: dark)",
      );
      if (darkModeMediaQuery.matches) {
        document.documentElement.classList.add("dark");
      }
      darkModeMediaQuery.addEventListener("change", (event) => {
        if (event.matches) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      });
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen flex flex-col font-sans antialiased selection:bg-primary/20">
    <!-- Header / Nav -->
    <header class="border-b border-border/40 bg-background/95 backdrop-blur-md sticky top-0 z-50 transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <!-- Drafting Compass / Triangle Logo Icon -->
          <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20"></path>
            <path d="m17 5 3 3-11 11-4 1 1-4Z"></path>
          </svg>
          <span class="font-semibold text-lg tracking-tight">RevitDraft</span>
        </div>
        
        <nav class="hidden md:flex items-center gap-6">
          <a href="#services" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Services</a>
          <a href="#about" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">About Us</a>
          <a href="#portfolio" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Our Work</a>
        </nav>

        <div>
          <a href="#contact" class="inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors">
            Get a Quote
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1 relative overflow-hidden">
      <!-- Background Decorative Grid and Glows (using theme colors) -->
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-[0.25] dark:opacity-[0.15]"></div>
      
      <!-- Primary Glow Effect -->
      <div class="absolute top-[-10%] left-1/2 -z-10 h-[600px] w-[1000px] -translate-x-1/2 rounded-full bg-primary/10 blur-[120px] dark:bg-primary/5"></div>

      <!-- Hero Section Container -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 md:pt-32 md:pb-36 text-center">
        <!-- Accent Badge -->
        <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3.5 py-1 text-sm font-medium text-primary mb-6 animate-fade-in">
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
          Professional Drafting Services
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight max-w-4xl mx-auto leading-[1.1] mb-6">
          Revit drafting <span class="bg-gradient-to-r from-primary to-accent-foreground bg-clip-text text-transparent">consultants</span>
        </h1>

        <!-- Tagline / Subtitle -->
        <p class="text-lg sm:text-xl md:text-2xl font-medium text-muted-foreground max-w-2xl mx-auto mb-4">
          Fast Revit drawings
        </p>

        <!-- Brief Supporting Copy -->
        <p class="text-base text-muted-foreground/80 max-w-xl mx-auto mb-10 leading-relaxed">
          High-precision BIM modeling, architectural drafting, and detailed construction documentation delivered on time by expert Autodesk certified specialists.
        </p>

        <!-- Call to Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <a href="#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-lg bg-primary text-primary-foreground font-semibold px-8 py-4 shadow-lg shadow-primary/20 hover:bg-primary/90 transition-all duration-200 transform hover:-translate-y-0.5">
            Contact us
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a href="#portfolio" class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-border bg-background text-foreground font-semibold px-8 py-4 hover:bg-muted/50 transition-all duration-200">
            View Projects
          </a>
        </div>

        <!-- Beautiful Drafting/Blueprint Mockup Element -->
        <div class="relative max-w-5xl mx-auto rounded-xl border border-border bg-card shadow-2xl overflow-hidden group">
          <!-- Glassmorphism overlay bar -->
          <div class="flex items-center justify-between border-b border-border bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-destructive/40"></span>
              <span class="w-3 h-3 rounded-full bg-accent/40"></span>
              <span class="w-3 h-3 rounded-full bg-primary/40"></span>
            </div>
            <div class="text-xs text-muted-foreground font-mono">revit_building_model.rvt</div>
            <div class="w-12"></div>
          </div>
          
          <!-- Mockup CAD/BIM Layout -->
          <div class="aspect-[16/10] sm:aspect-[16/9] w-full bg-slate-950 p-6 md:p-10 flex flex-col justify-between relative overflow-hidden font-mono text-[10px] md:text-xs text-cyan-500/80">
            <!-- CAD Grid lines -->
            <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(6,182,212,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(6,182,212,0.05)_1px,transparent_1px)] bg-[size:2rem_2rem]"></div>
            
            <!-- Isometric/Technical Drawing Lines mockup -->
            <svg class="absolute inset-0 w-full h-full p-4 opacity-75" viewBox="0 0 800 450" fill="none" stroke="currentColor" stroke-width="1">
              <!-- Coordinate axis -->
              <path d="M 50,50 L 50,400 L 750,400" stroke="rgba(6,182,212,0.2)"></path>
              
              <!-- Isometric building cube lines -->
              <path d="M 400,100 L 550,180 L 550,330 L 400,250 Z" stroke="rgba(6,182,212,0.4)" stroke-width="1.5"></path>
              <path d="M 400,100 L 250,180 L 250,330 L 400,250 Z" stroke="rgba(6,182,212,0.4)" stroke-width="1.5"></path>
              <path d="M 400,100 L 550,180 L 400,260 L 250,180 Z" stroke="rgba(6,182,212,0.3)"></path>
              
              <!-- Inner layout lines / studs -->
              <path d="M 300,207 L 300,302 M 350,233 L 350,329 M 450,207 L 450,302 M 500,233 L 500,329" stroke="rgba(6,182,212,0.25)"></path>
              <path d="M 250,210 L 400,130 L 550,210" stroke="rgba(6,182,212,0.3)" stroke-dasharray="4 4"></path>

              <!-- Dimension lines -->
              <path d="M 230,180 L 230,330" stroke="#f43f5e" stroke-width="1"></path>
              <path d="M 225,180 L 235,180 M 225,330 L 235,330" stroke="#f43f5e"></path>
              <text x="180" y="260" fill="#f43f5e" font-size="10">H: 4500mm</text>

              <path d="M 250,350 L 400,270" stroke="#f43f5e" stroke-width="1"></path>
              <path d="M 248,345 L 252,355 M 398,265 L 402,275" stroke="#f43f5e"></path>
              <text x="300" y="330" fill="#f43f5e" font-size="10" transform="rotate(-28, 300, 330)">W: 8000mm</text>

              <!-- Circle detail callout -->
              <circle cx="400" cy="250" r="40" stroke="rgba(234,179,8,0.6)" stroke-dasharray="3 3" stroke-width="1.5"></circle>
              <path d="M 435,230 L 490,200 L 520,200" stroke="rgba(234,179,8,0.8)" stroke-width="1"></path>
              <text x="525" y="196" fill="rgba(234,179,8,0.9)" font-size="10">DETAIL A04</text>
            </svg>

            <!-- CAD Status overlays -->
            <div class="z-10 flex justify-between items-start w-full">
              <div class="bg-black/60 backdrop-blur border border-cyan-500/30 p-2 rounded">
                <div>[3D VIEW: ISOMETRIC EAST]</div>
                <div class="text-emerald-400">STATUS: READY</div>
              </div>
              <div class="bg-black/60 backdrop-blur border border-cyan-500/30 p-2 rounded text-right">
                <div>SCALE: 1:50</div>
                <div>PROJECT: #9312-A</div>
              </div>
            </div>

            <div class="z-10 flex justify-between items-end w-full">
              <div class="bg-black/60 backdrop-blur border border-cyan-500/30 p-2 rounded">
                <div>X: 142.392</div>
                <div>Y: -89.412</div>
                <div>Z: 12.000</div>
              </div>
              <div class="text-cyan-500/50 text-[9px]">AUTODESK REVIT ENGINE COMPATIBLE</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-border/40 py-8 bg-muted/20 text-center text-xs text-muted-foreground">
      <div class="max-w-7xl mx-auto px-4">
        &copy; {new Date().getFullYear()} RevitDraft Consultants. All rights reserved. Fast Revit drawings, high-fidelity BIM deliverables.
      </div>
    </footer>
  </body>
</html>
