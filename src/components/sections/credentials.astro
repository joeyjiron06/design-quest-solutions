---
/**
 * Credentials — copy doc §3.
 *
 * A fact strip, not a statistics section. It has no section heading and no
 * icons on purpose: the copy doc argues a strip reads as more confident when
 * it does not introduce itself, and icons turn credibility into decoration.
 *
 * Marked up as a description list rather than four headings, because these are
 * label/definition pairs and inventing four <h2>s here would distort the
 * document outline for a section that deliberately has no title.
 *
 * Every fact is approved in Branding.md §6. Nothing may be added here without
 * evidence behind it.
 */
import { site } from "../../data/site";
import Section from "../layout/section.astro";
import HairlineGrid from "../ui/hairlineGrid.astro";
---

<Section
  id="credentials"
  tone="card"
  label="Credentials"
  flush
  class="border-border/70 border-b"
>
  <HairlineGrid tone="card" class="sm:grid-cols-2 lg:grid-cols-4">
    {
      site.credentials.map((item) => (
        <dl class="py-10 sm:px-7 lg:py-14">
          <span class="bg-accent block h-px w-8" />
          <dt class="mt-5 font-serif text-[21px] leading-tight tracking-[-0.01em]">
            {item.label}
          </dt>
          <dd class="text-muted-foreground mt-3 text-[13.5px] leading-6">
            {item.note}
          </dd>
        </dl>
      ))
    }
  </HairlineGrid>
</Section>
