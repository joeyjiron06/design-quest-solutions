---
/**
 * Small mono label in caps. Names a column or a sub-list inside a section.
 *
 * Distinct from Eyebrow: an eyebrow is accent-coloured and introduces a whole
 * section, this one is muted and sits inside one. Keeping them apart stops the
 * page growing a second accent colour by accident.
 */
interface Props {
  as?: "h3" | "h4" | "p" | "span" | "div";
  class?: string;
}

const { as: Tag = "h3", class: className = "" } = Astro.props;
---

<Tag
  class:list={[
    "text-muted-foreground font-mono text-[10px] tracking-[0.24em] uppercase",
    className,
  ]}
>
  <slot />
</Tag>
