---
/**
 * Disclosure. A native <details>/<summary>, styled to the house hairline look.
 *
 * Native was chosen over a scripted accordion because it is keyboard and
 * screen-reader correct with no work, and the content stays in the DOM when
 * collapsed so it is still indexed.
 *
 * `staticFrom` makes the panel behave as a plain column at that breakpoint and
 * above: the summary stops responding and the +/- marker disappears. The open
 * state itself is set by script (see the section that uses it), which is why
 * those call sites also pass `open` — with scripting off, the desktop layout
 * is the one that renders correctly.
 *
 * The breakpoint is a fixed map rather than an interpolated class name,
 * because Tailwind only emits classes it can see spelled out in the source.
 */
interface Props {
  title: string;
  /** Heading level for the title, so the page outline stays correct. */
  titleAs?: "h3" | "h4";
  open?: boolean;
  staticFrom?: "md" | "lg";
  titleClass?: string;
  panelClass?: string;
  class?: string;
}

const {
  title,
  titleAs: Title = "h3",
  open = false,
  staticFrom,
  titleClass = "",
  panelClass = "",
  class: className = "",
} = Astro.props;

const staticStyles = {
  md: {
    summary: "md:pointer-events-none md:cursor-default md:py-0",
    marker: "md:hidden",
    panel: "md:pb-0",
  },
  lg: {
    summary: "lg:pointer-events-none lg:cursor-default lg:py-0",
    marker: "lg:hidden",
    panel: "lg:pb-0",
  },
};

const s = staticFrom ? staticStyles[staticFrom] : undefined;
---

<details
  open={open}
  data-static-from={staticFrom}
  class:list={["group", className]}
>
  <summary
    class:list={[
      "flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden",
      s?.summary,
    ]}
  >
    <Title class:list={["min-w-0", titleClass]}>{title}</Title>

    {/* Plus that becomes a minus. Two hairlines, no icon font. */}
    <span
      class:list={["relative mt-1.5 h-3 w-3 shrink-0", s?.marker]}
      aria-hidden="true"
    >
      <span class="bg-current absolute top-1/2 left-0 h-px w-3 -translate-y-1/2"
      ></span>
      <span
        class="bg-current absolute top-0 left-1/2 h-3 w-px -translate-x-1/2 transition-transform duration-200 group-open:scale-y-0"
      ></span>
    </span>
  </summary>

  <div class:list={["pb-6", s?.panel, panelClass]}>
    <slot />
  </div>
</details>
