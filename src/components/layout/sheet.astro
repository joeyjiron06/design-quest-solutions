---
/**
 * The drawing sheet: double border, edge zone markers and the navigation.
 * Content goes in the slot, below the nav.
 *
 * Kept separate from the hero so the sheet device can wrap another section
 * later without the hero's copy coming with it.
 */
import Navbar from "./navbar.astro";

interface Props {
  /** Anchor id. Must be unique on the page. */
  id: string;
}

const { id } = Astro.props;

const zonesX = ["A", "B", "C", "D", "E", "F", "G", "H"];
const zonesY = ["1", "2", "3", "4", "5"];
---

<section
  id={id}
  class="dark bg-background text-foreground flex min-h-dvh flex-col"
>
  <div class="flex flex-1 flex-col p-3 lg:p-6">
    <!-- outer sheet line -->
    <div class="border-border/35 flex flex-1 flex-col border p-[5px]">
      <!-- inner sheet line -->
      <div class="border-border/70 flex flex-1 flex-col border">
        <!-- top zone markers -->
        <div
          class="border-border/30 text-muted-foreground/60 hidden h-5 items-stretch border-b font-mono text-[8px] tracking-[0.2em] uppercase sm:flex"
          aria-hidden="true"
        >
          <span class="border-border/30 w-5 shrink-0 border-r"></span>
          {
            zonesX.map((zone) => (
              <span class="border-border/30 flex flex-1 items-center justify-center border-r last:border-r-0">
                {zone}
              </span>
            ))
          }
        </div>

        <div class="flex flex-1">
          <!-- left zone markers -->
          <div
            class="border-border/30 text-muted-foreground/60 hidden w-5 shrink-0 flex-col border-r font-mono text-[8px] tracking-[0.2em] sm:flex"
            aria-hidden="true"
          >
            {
              zonesY.map((zone) => (
                <span class="border-border/30 flex flex-1 items-center justify-center border-b last:border-b-0">
                  {zone}
                </span>
              ))
            }
          </div>

          <div class="flex min-w-0 flex-1 flex-col">
            <Navbar />
            <slot />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
