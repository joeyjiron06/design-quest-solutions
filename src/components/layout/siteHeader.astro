---
/**
 * Sticky header — copy doc §1.
 *
 * The navbar inside the hero sheet cannot be sticky, because it lives inside
 * the drawing frame. This is the separate bar that navbar.astro anticipated:
 * it stays out of the way until the hero has scrolled past, then holds the
 * page nav for the rest of the scroll.
 *
 * It also carries the mobile menu. Below `lg` the four links have nowhere else
 * to go, so without this they are simply unreachable on a phone.
 *
 * The button never collapses into the menu (copy doc §1). It is the only
 * conversion point in the bar.
 */
import { site } from "../../data/site";
import Button from "../ui/button.astro";
---

<header
  id="site-header"
  class="border-border/70 bg-background/95 invisible fixed inset-x-0 top-0 z-50 -translate-y-full border-b opacity-0 backdrop-blur transition-[transform,opacity,visibility] duration-300 data-[visible]:visible data-[visible]:translate-y-0 data-[visible]:opacity-100"
>
  <div
    class="mx-auto flex w-full max-w-[84rem] items-center justify-between gap-5 px-5 py-3.5 lg:px-10"
  >
    <a
      href="#top"
      class="font-serif text-[11px] tracking-[0.25em] whitespace-nowrap uppercase lg:text-[12px] lg:tracking-[0.3em]"
    >
      {site.brand}
    </a>

    <nav aria-label="Page sections" class="hidden items-center gap-8 lg:flex">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="text-muted-foreground hover:text-accent font-mono text-[10px] tracking-[0.2em] uppercase transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <Button
        href={site.quoteHref}
        variant="secondary"
        size="sm"
        class="font-mono"
      >
        {site.cta.primary}
      </Button>

      <button
        id="site-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open navigation"
        class="group border-border hover:border-accent flex h-9 w-9 shrink-0 items-center justify-center border transition-colors lg:hidden"
      >
        {/* Three hairlines that fold into a cross. No icon font. */}
        <span class="relative block h-3 w-4" aria-hidden="true">
          <span
            class="bg-current absolute top-0 left-0 h-px w-4 transition-transform duration-200 group-aria-expanded:translate-y-[6px] group-aria-expanded:rotate-45"
          ></span>
          <span
            class="bg-current absolute top-[6px] left-0 h-px w-4 transition-opacity duration-200 group-aria-expanded:opacity-0"
          ></span>
          <span
            class="bg-current absolute top-[12px] left-0 h-px w-4 transition-transform duration-200 group-aria-expanded:-translate-y-[6px] group-aria-expanded:-rotate-45"
          ></span>
        </span>
      </button>
    </div>
  </div>

  <nav
    id="site-menu"
    aria-label="Page sections"
    hidden
    class="border-border/70 border-t lg:hidden"
  >
    <ul class="mx-auto w-full max-w-[84rem] px-5 py-2">
      {
        site.nav.map((item) => (
          <li class="border-border/50 border-b last:border-b-0">
            <a
              href={item.href}
              class="hover:text-accent block py-4 font-mono text-[11px] tracking-[0.2em] uppercase transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const hero = document.getElementById("top");
  const toggle = document.getElementById("site-menu-toggle");
  const menu = document.getElementById("site-menu");

  const closeMenu = () => {
    menu?.setAttribute("hidden", "");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation");
  };

  /* Reveal once the hero has left the viewport. An observer rather than a
     scroll handler, so nothing runs on every frame. */
  if (header && hero) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          header.removeAttribute("data-visible");
          closeMenu();
        } else {
          header.setAttribute("data-visible", "");
        }
      },
      { threshold: 0 },
    ).observe(hero);
  }

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    if (open) {
      closeMenu();
      return;
    }
    menu?.removeAttribute("hidden");
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Close navigation");
  });

  /* Following an anchor should not leave the panel covering the target. */
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
